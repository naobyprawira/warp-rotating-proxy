[Unit]
Description=Cloudflare WARP Rotating HTTP Proxy
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/warp-rotating-proxy/warp_rotating_proxy.py
Environment=WARP_PROXY_HOST=127.0.0.1
Environment=WARP_PROXY_PORT=40001
Environment=WARP_SOCKS_HOST=127.0.0.1
Environment=WARP_SOCKS_PORT=40000
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
